# Copy to deploy/gcp/secrets.env (git-ignored), fill in, then run: bash deploy/gcp/secrets.sh
# Empty values are skipped. Re-running only adds a new version when a value changed.

MONGODB_URI=
# Must be the SAME key the database's Gmail connection was saved with.
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
# Only used when the users collection is empty. At least 16 characters.
BOOTSTRAP_ADMIN_PASSWORD=
