PROJECT_ID=dynarock-backend-2026
REGION=asia-south1
REPO=cloud-run-source-deploy

API_SERVICE=dynarock-sales-api
API_DOMAIN=api.sales.dynarock.in

# Cloud Build deploys every push to main of this repo (trigger.yaml).
