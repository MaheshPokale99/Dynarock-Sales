PROJECT_ID=dynarock-backend-2026
REGION=asia-south1
REPO=dynarock

API_SERVICE=dynarock-sales-api
API_DOMAIN=api.sales.dynarock.in

# GitHub Actions deploys from this repo and branch (keyless, through Workload Identity Federation).
GITHUB_REPO=MaheshPokale99/admission-detective-api
DEPLOY_BRANCH=main
WIF_POOL=github-actions
WIF_PROVIDER=dynarock-sales

# Route API traffic through Cloud NAT with one fixed IP, for the MongoDB Atlas allowlist.
STATIC_EGRESS=true

# Service settings (env vars, secrets, CPU, memory, scaling, networking) live in /cloudbuild.yaml.
