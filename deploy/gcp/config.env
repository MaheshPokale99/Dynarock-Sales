PROJECT_ID=dynarock-backend-2026
REGION=asia-south1
REPO=cloud-run-source-deploy

API_SERVICE=dynarock-sales-api
API_DOMAIN=api.sales.dynarock.in

# Cloud Build deploys every push to main of this repo (trigger.yaml).
GITHUB_REPO=MaheshPokale99/Dynarock-Sales

# true: route API traffic through Cloud NAT with one fixed IP (only needed if Atlas allows specific IPs, not 0.0.0.0/0).
STATIC_EGRESS=false

# Service settings (env vars, secrets, CPU, memory, scaling, networking) live in /cloudbuild.yaml.
