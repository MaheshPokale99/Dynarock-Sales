{
    "eslint.workingDirectories": [
        { "directory": "./backend", "changeProcessCWD": true },
        { "directory": "./frontend", "changeProcessCWD": true }
    ],
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/.next/**": true,
        "**/dist/**": true,
        "**/data/**": true,
        "**/logs/**": true
    },
    "search.exclude": {
        "**/.next": true,
        "**/data": true
    }
}
