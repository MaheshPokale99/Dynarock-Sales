# --- Server ---
# development | test | production
NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Also append every log line to this file as JSON (the console output stays on). Leave empty for console only.
LOG_FILE=logs/app.log
# Where the web app runs: allowed for CORS, and the first one is used to build invitation links. Comma separated.
FRONTEND_ORIGIN=http://localhost:3000

# --- Database (MongoDB) ---
# Local MongoDB, Docker (`docker compose up -d mongo`), the zero-install one (`npm run db:local`) or MongoDB Atlas:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dynarock_sales
MONGODB_URI=mongodb://127.0.0.1:27017/dynarock_sales

# --- Accounts ---
# How long a sign-in lasts, and how long an invitation link stays valid.
SESSION_TTL_DAYS=14
INVITE_TTL_DAYS=7
# Send the session cookie over HTTPS only. Leave empty: on in production, off otherwise.
COOKIE_SECURE=
# The first admin is created from these when the database has no users yet. Change the password after signing in.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@dynarock.in
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# --- Mailbox (Gmail on Google Workspace) ---
# The shared address the team sends from. Connecting any other account is refused.
MAILBOX_ADDRESS=sales@dynarock.in
# OAuth client from Google Cloud Console (APIs & Services > Credentials > OAuth client ID, type "Web application").
# Leave empty until it is set up: the app runs, the mailbox just stays "not connected".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed under "Authorized redirect URIs" on that client. Leave empty for http://localhost:<PORT>/api/v1/mailbox/oauth/callback
GOOGLE_REDIRECT_URI=
# Encrypts the stored Gmail tokens. 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# How often new mail is fetched from Gmail.
GMAIL_SYNC_INTERVAL_SECONDS=60

# --- Gemini (AI writing, reply suggestions and follow-ups) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Rate limits (per client address, per minute) ---
RATE_LIMIT_PER_MINUTE=300
# Stricter limit on sign-in and invitation endpoints, against password guessing.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Set true behind a reverse proxy so the client address is read from X-Forwarded-For.
TRUST_PROXY=false
