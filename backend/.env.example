# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
LOG_FILE=logs/app.log
FRONTEND_ORIGIN=http://localhost:3000
# Public URL of this API, used in unsubscribe links. Empty = http://localhost:<PORT>
API_PUBLIC_URL=

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/dynarock_sales

# Accounts (first admin is created when there are no users)
SESSION_TTL_DAYS=14
INVITE_TTL_DAYS=7
COOKIE_SECURE=
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@dynarock.in
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Gmail (see docs/gmail-setup.md)
MAILBOX_ADDRESS=sales@dynarock.in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
GMAIL_SYNC_INTERVAL_SECONDS=60

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Rate limits (per minute)
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY=false

# Daily limits (protect the mailbox reputation and the AI bill)
USER_DAILY_SEND_LIMIT=200
MAILBOX_DAILY_SEND_LIMIT=1500
AI_DAILY_CALL_LIMIT=1500

# Email layout. Logo must be a PNG/JPG URL (SVG doesn't show in Gmail or Outlook).
# With EMAIL_DEMO_URL set, [[BOOK_DEMO]] on its own line in an email becomes a "Book a demo" button.
EMAIL_LOGO_URL=
EMAIL_BRAND_COLOR=#06294f
EMAIL_DEMO_URL=

# Background work (Gmail sync, follow-ups). "timers" runs it in-process; "cron" runs it on
# POST /internal/tick with the X-Cron-Secret header (Cloud Run with request-based billing).
WORKER_MODE=timers
CRON_SECRET=
