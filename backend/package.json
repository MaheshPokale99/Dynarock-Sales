{
    "name": "dynarock-sales-backend",
    "version": "1.0.0",
    "description": "Dynarock Sales API: shared sales mailbox, AI follow-ups and analytics",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "start": "node dist/server.js",
        "start:dev": "tsx src/server.ts",
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
        "db:local": "tsx scripts/dev-db.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "knip": "knip",
        "dev:fake-mail": "tsx watch scripts/dev-fake-mail.ts"
    },
    "type": "module",
    "dependencies": {
        "@google/genai": "^2.29.1",
        "@hono/node-server": "^2.1.5",
        "@node-rs/argon2": "^2.2.2",
        "dotenv": "^18.0.7",
        "hono": "^4.13.13",
        "mongoose": "^9.12.2",
        "nodemailer": "^10.6.0",
        "pino": "^10.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/mailparser": "^3.9.0",
        "@types/node": "^26.6.5",
        "@types/nodemailer": "^8.0.2",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "knip": "^6.41.0",
        "mailparser": "^3.14.5",
        "mongodb-memory-server": "^11.3.0",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "~6.0",
        "typescript-eslint": "^8.71.2"
    },
    "private": true,
    "engines": {
        "node": ">=22.13"
    }
}
